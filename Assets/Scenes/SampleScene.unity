  m_Script: {fileID: 11500000, guid: 4e3626e9b7c709e4e95fb057f7e950dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hotspot
  nombreEstructura: Huesos de la Mano (27 en total)
  descripcion: "Funci\xF3n: \nPermiten el agarre de objetos, la manipulaci\xF3n precisa
    y realizar movimientos finos y complejos.\nCuriosidades:\n\xA1Junto con los pies,
    contienen m\xE1s de la mitad de los huesos de todo tu cuerpo!\nEl pulgar tiene
    solo 2 falanges (huesos de los dedos), mientras que el resto tiene 3.\nLos dedos
    en s\xED no tienen m\xFAsculos; se mueven como marionetas gracias a tendones
    controlados desde el antebrazo y la palma."
