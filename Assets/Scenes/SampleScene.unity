  m_Script: {fileID: 11500000, guid: 4e3626e9b7c709e4e95fb057f7e950dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hotspot
  nombreEstructura: Costillas (12 pares)
  descripcion: "Funci\xF3n: \nForman una caja protectora para el coraz\xF3n y los
    pulmones, y se expanden para permitir la respiraci\xF3n.\nCuriosidades:\nSe clasifican
    en 7 pares \"verdaderas\", 3 \"falsas\" y 2 \"flotantes\" (que no se unen al
    estern\xF3n).\nNo son r\xEDgidas; act\xFAan como una jaula flexible capaz de
    absorber impactos fuertes sin romperse.\nCada vez que tomas aire profundo, se
    levantan hacia afuera con un movimiento similar al asa de un balde."
