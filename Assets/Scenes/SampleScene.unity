  m_Script: {fileID: 11500000, guid: 4e3626e9b7c709e4e95fb057f7e950dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hotspot
  nombreEstructura: "Estern\xF3n"
  descripcion: "Funci\xF3n: \nAncla las costillas en el centro del pecho y act\xFAa
    como un poderoso escudo frontal que protege el coraz\xF3n y los pulmones.\nCuriosidades:\nSu
    anatom\xEDa recuerda a una antigua espada corta, dividida en empu\xF1adura (manubrio),
    hoja (cuerpo) y punta (ap\xF3fisis xifoides).\nEs el punto exacto donde se debe
    aplicar presi\xF3n al realizar maniobras de RCP (reanimaci\xF3n cardiopulmonar).\nSu
    punta inferior es un cart\xEDlago flexible durante casi toda la vida y reci\xE9n
    se convierte en hueso duro (se osifica) pasados los 40 a\xF1os."
