  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e3626e9b7c709e4e95fb057f7e950dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hotspot
  nombreEstructura: "Cr\xE1neo"
  descripcion: "Funci\xF3n: \nFunciona como un casco acorazado que protege el fr\xE1gil
    cerebro, sostiene los \xF3rganos de los sentidos (vista, o\xEDdo, olfato) y proporciona
    la estructura fundamental del rostro.\nCuriosidades:\nAl nacer, estos huesos
    est\xE1n separados por zonas blandas (fontanelas o \"molleras\") para permitir
    que la cabeza se comprima al pasar por el canal de parto y que el cerebro crezca.\nSe
    unen firmemente en la adultez como piezas de un rompecabezas 3D, formando l\xEDneas
    en zigzag llamadas \"suturas\".\nEn su interior, espec\xEDficamente en los huesos
    temporales, se esconden los tres huesos m\xE1s peque\xF1os de todo el cuerpo:
    el martillo, el yunque y el estribo (vitales para la audici\xF3n)."
