  m_Script: {fileID: 11500000, guid: 4e3626e9b7c709e4e95fb057f7e950dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hotspot
  nombreEstructura: "Columna Vertebral (5 regiones: Cervical, Tor\xE1cica, Lumbar,
    Sacro y C\xF3ccix)"
  descripcion: "Funci\xF3n: \nSostiene el peso del tronco, permite los movimientos
    de la espalda y funciona como un tubo protector de armadura para la delicada
    m\xE9dula espinal.\nCuriosidades:\nNacemos con 33 v\xE9rtebras, pero de adultos
    tenemos 26 porque los huesos del sacro y el c\xF3ccix se fusionan.\nLa primera
    v\xE9rtebra del cuello se llama \"Atlas\" porque soporta tu cabeza, igual que
    el tit\xE1n griego sosten\xEDa el mundo.\n\xA1Eres m\xE1s alto por la ma\xF1ana!
    Los discos de cart\xEDlago entre las v\xE9rtebras se van comprimiendo durante
    el d\xEDa por la gravedad."
