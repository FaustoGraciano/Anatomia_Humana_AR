  m_Script: {fileID: 11500000, guid: 4e3626e9b7c709e4e95fb057f7e950dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hotspot
  nombreEstructura: "Antebrazo (Radio y C\xFAbito)"
  descripcion: "Funci\xF3n: \nConectan el codo con la mu\xF1eca. El radio permite
    girar la mano, mientras que el c\xFAbito act\xFAa como una bisagra estable para
    doblar el codo.\n\nCuriosidades:\nTrabajan en equipo: al girar la palma hacia
    abajo, el radio se cruza por encima del c\xFAbito formando una \"X\".\nEl c\xFAbito
    es m\xE1s grande y fuerte en la zona del codo, pero el radio domina en la zona
    de la mu\xF1eca.\nEl golpe el\xE9ctrico del \"hueso de la risa\" en el codo es
    en realidad el nervio cubital rozando directamente contra el c\xFAbito."
