  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e3626e9b7c709e4e95fb057f7e950dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hotspot
  nombreEstructura: "Clav\xEDcula"
  descripcion: "Funci\xF3n:\nConecta el brazo con el tronco (del estern\xF3n al om\xF3plato)
    y funciona como un soporte estructural que mantiene los hombros en su lugar,
    permitiendo el libre movimiento de los brazos.\nCuriosidades: \nEs el \xFAnico
    hueso largo de todo el cuerpo humano que se ubica en posici\xF3n horizontal.\nSu
    nombre en lat\xEDn significa \"llave peque\xF1a\", ya que gira sobre su propio
    eje (como una llave en una cerradura) cada vez que levantas el brazo.\nEs uno
    de los huesos que m\xE1s frecuentemente se fractura, casi siempre debido al acto
    reflejo de amortiguar una ca\xEDda con el brazo extendido."
