  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e3626e9b7c709e4e95fb057f7e950dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hotspot
  nombreEstructura: "Peron\xE9"
  descripcion: "Funci\xF3n: \nEstabiliza la articulaci\xF3n del tobillo y sirve de
    anclaje para varios m\xFAsculos de la pierna. A diferencia de la tibia, casi
    no soporta peso.\nCuriosidades:\nEs el hueso m\xE1s delgado del cuerpo en proporci\xF3n
    a su longitud.\nSu nombre en lat\xEDn (f\xEDbula) significa \"broche\" o \"alfiler\".\nEs
    muy utilizado por los cirujanos para hacer injertos \xF3seos (como reconstruir
    una mand\xEDbula), ya que se puede extraer una parte sin que la pierna pierda
    su funci\xF3n."
